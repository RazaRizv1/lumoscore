{
  "name": "lumoscore",
  "version": "1.0.0",
  "private": true,
  "description": "LumosCore — multi-chain DeFi front end on Stellar mainnet. Static build, deployed to Cloudflare Pages as TWO separate projects: the public site (dist) and the admin panel (dist-admin, behind Cloudflare Access).",
  "scripts": {
    "build": "node _tools/extract_site.js aptos --root && node _tools/_externalize.js",
    "build:admin": "node _tools/extract_site.js aptos --admin",
    "build:all": "npm run build && npm run build:admin",
    "serve": "node serve.js 8080",
    "serve:admin": "node serve.js 8080 --admin",
    "deploy": "wrangler pages deploy dist --project-name=lumoscore --commit-dirty=true",
    "deploy:staging": "wrangler pages deploy dist --project-name=lumoscore-staging --commit-dirty=true",
    "deploy:admin": "wrangler pages deploy dist-admin --project-name=lumoscore-admin --branch=main --commit-dirty=true",
    "predeploy": "node _tools/predeploy_check.js",
    "predeploy:admin": "node _tools/predeploy_check.js --admin",
    "test:mail": "node _email-worker/test/mime.test.mjs",
    "merge:xrpl": "node _tools/_mergexrpl.js",
    "build:merged": "npm run build && npm run merge:xrpl",
    "check:release": "node _tools/release_check.js"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "wrangler": "^4.126.0"
  }
}
